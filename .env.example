# Survey Storytelling — Environment Variables
# Copy this file to .env and fill in values (DO NOT commit .env)

# DeepSeek API configuration (REQUIRED — unico motor cualitativo desde v3.2.0)
# El motor legacy (spaCy + sentence-transformers) fue eliminado en v3.2.0.
# Sin esta key el ETL cualitativo falla; NO existe fallback.
DEEPSEEK_API_KEY=sk-your-key-here

# Optional: Disable IA cache (JSON file with hashed results)
# IA_CUALITATIVO_CACHE=0

# Optional: IA worker pool configuration
# IA_CUALITATIVO_WORKERS=15
# IA_CUALITATIVO_MAX_RPM=60
# IA_CUALITATIVO_TIMEOUT=60
