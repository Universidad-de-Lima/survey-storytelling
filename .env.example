# ============================================================================
# Survey Storytelling — Environment Variables
# ============================================================================

# ─── General ─────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── Backend ─────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
DATA_DIR=./zoho-survey/students
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api
VITE_DEFAULT_PERIOD=latest
VITE_DEFAULT_LEVEL=undergraduate
