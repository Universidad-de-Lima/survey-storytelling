{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://universidad-de-lima.github.io/survey-storytelling/schemas/sentimiento.json",
  "title": "Sentimiento",
  "description": "Análisis cualitativo de comentarios NPS (tópicos, frases, distribución, comentarios individuales e insights).",
  "type": "object",
  "required": ["version", "resumen", "topicos", "por_carrera", "por_ciclo"],
  "properties": {
    "version": {
      "type": "string",
      "const": "3.0"
    },
    "resumen": {
      "type": "object",
      "required": ["total_con_comentario", "total_analizados", "pasivos", "detractores", "comentarios_invalidos"],
      "properties": {
        "total_respuestas": { "type": "integer", "minimum": 0 },
        "total_con_comentario": { "type": "integer", "minimum": 0 },
        "total_analizados": { "type": "integer", "minimum": 0 },
        "comentarios_invalidos": { "type": "integer", "minimum": 0 },
        "distribucion_sentimiento": {
          "type": "object",
          "properties": {
            "positivo": { "type": "integer", "minimum": 0 },
            "neutro": { "type": "integer", "minimum": 0 },
            "negativo": { "type": "integer", "minimum": 0 }
          }
        },
        "distribucion_intensidad": {
          "type": "object",
          "properties": {
            "alta": { "type": "integer", "minimum": 0 },
            "media": { "type": "integer", "minimum": 0 },
            "baja": { "type": "integer", "minimum": 0 }
          }
        },
        "pasivos": { "type": "integer", "minimum": 0 },
        "detractores": { "type": "integer", "minimum": 0 },
        "nota": { "type": "string" }
      }
    },
    "insights_ia": {
      "type": "object",
      "properties": {
        "global": { "type": "string" },
        "por_categoria_padre": { "type": "object" }
      }
    },
    "topicos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topico", "tipo", "icono", "total_comentarios", "detractores", "pasivos", "frases_representativas"],
        "properties": {
          "topico": { "type": "string" },
          "categoria_padre": { "type": "string" },
          "tipo": { "type": "string", "enum": ["negativo", "mejora", "positivo"] },
          "icono": { "type": "string" },
          "total_comentarios": { "type": "integer", "minimum": 0 },
          "detractores": { "type": "integer", "minimum": 0 },
          "pasivos": { "type": "integer", "minimum": 0 },
          "sentimiento_predominante": { "type": "string" },
          "intensidad_promedio": { "type": "number" },
          "frases_representativas": { "type": "array", "items": { "type": "string" } },
          "por_carrera": { "type": "object" },
          "por_facultad": { "type": "object" },
          "por_ciclo": { "type": "object" }
        }
      }
    },
    "comentarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "carrera", "facultad", "ciclo", "nps_score", "sentimiento", "intensidad", "categoria", "categoria_padre", "fragmento_original", "fragmento_mostrar", "es_valido"],
        "properties": {
          "id": { "type": "string" },
          "carrera": { "type": "string" },
          "facultad": { "type": "string" },
          "ciclo": { "type": "string" },
          "nps_score": { "type": "integer" },
          "sentimiento": { "type": "string", "enum": ["positivo", "negativo", "neutro"] },
          "intensidad": { "type": "number" },
          "categoria": { "type": "string" },
          "categoria_padre": { "type": "string" },
          "fragmento_original": { "type": "string" },
          "fragmento_mostrar": { "type": "string" },
          "es_valido": { "type": "boolean" },
          "motivo_invalidez": { "type": "string" }
        }
      }
    },
    "por_carrera": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["carrera", "total", "pasivos", "detractores"],
        "properties": {
          "carrera": { "type": "string" },
          "facultad": { "type": "string" },
          "total": { "type": "integer", "minimum": 0 },
          "pasivos": { "type": "integer", "minimum": 0 },
          "detractores": { "type": "integer", "minimum": 0 },
          "comentarios_invalidos": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "por_ciclo": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ciclo", "total", "pasivos", "detractores"],
        "properties": {
          "ciclo": { "type": "string" },
          "total": { "type": "integer", "minimum": 0 },
          "pasivos": { "type": "integer", "minimum": 0 },
          "detractores": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
